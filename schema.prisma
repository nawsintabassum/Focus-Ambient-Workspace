generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  password     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     FocusSession[]
  favorites    FavoriteSound[]
  workspaces   Workspace[]
  preference   UserPreference?
}
model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  duration    Int
  completed   Boolean  @default(false)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
}
model Sound {
  id          String          @id @default(cuid())
  name        String          @unique
  category    String
  audioUrl    String
  imageUrl    String
  description String
  favorites   FavoriteSound[]
  workspaceSounds WorkspaceSound[]
}
model FavoriteSound {
  id        String   @id @default(cuid())
  userId    String
  soundId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sound     Sound    @relation(fields: [soundId], references: [id], onDelete: Cascade)
  @@unique([userId, soundId])
}
model Workspace {
  id            String           @id @default(cuid())
  userId        String
  name          String
  timerDuration Int              @default(25)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sounds        WorkspaceSound[]
  @@index([userId])
}
model WorkspaceSound {
  id          String    @id @default(cuid())
  workspaceId String
  soundId     String
  volume      Int       @default(50)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sound       Sound     @relation(fields: [soundId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, soundId])
}
model UserPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  theme        String  @default("dark")
  defaultTimer Int     @default(25)
  notifications Boolean @default(true)
  soundEnabled Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
